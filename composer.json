{
  "name": "surefeedback/surefeedback",
  "description": "Collect note-style feedback from your client's websites and sync them with your SureFeedback parent project.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "autoload": {
    "psr-4": {
      "SureFeedback\\": "includes/app/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5",
    "phpstan/phpstan": "^1.0",
    "szepeviktor/phpstan-wordpress": "^1.1",
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "^3.0",
    "dealerdirect/phpcodesniffer-composer-installer": "^0.7"
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "phpstan": "./vendor/bin/phpstan --memory-limit=2048M analyse",
    "phpcs": "vendor/bin/phpcs --standard=phpcs.xml.dist --report-full",
    "phpcbf": "vendor/bin/phpcbf --standard=phpcs.xml.dist --report-summary --report-source",
    "lint": "vendor/bin/phpcs --standard=phpcs.xml.dist -p",
    "format": "vendor/bin/phpcbf --standard=phpcs.xml.dist"
  },
  "config": {
    "platform": {
      "php": "7.4"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "require": {
    "php": "^7.4",
    "firebase/php-jwt": "^6.3"
  }
}
