{
  "name": "surefeedback/surefeedback",
  "description": "Collect note-style feedback from your client's websites and sync them with your SureFeedback parent project.",
  "autoload": {
    "psr-4": {
      "SureFeedback\\": "app/"
    }
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^0.7.0",
    "phpcompatibility/phpcompatibility-wp": "*",
    "wp-coding-standards/wpcs": "^2.1.0",
    "szepeviktor/phpstan-wordpress": "^1.1",
    "phpstan/phpstan": "^1.0",
    "php-stubs/wordpress-stubs": "^6.0",
    "php-stubs/generator": "^0.8.4",
    "phpunit/phpunit": "^9.5"
  },
  "scripts": {
    "format": "phpcbf --standard=phpcs.xml.dist --report-summary --report-source",
    "lint": "phpcs --standard=phpcs.xml.dist --report-summary --report-source",
    "gen-stubs": "php -d memory_limit=-1 vendor/bin/generate-stubs artifact/phpstan/surefeedback/ --out=tests/php/stubs/surefeedback-stubs.php && rm -rf artifact/phpstan",
    "phpstan": "vendor/bin/phpstan --memory-limit=2048M analyse",
    "test": "vendor/bin/phpunit",
    "test-unit": "vendor/bin/phpunit --testsuite=\"Unit Tests\"",
    "test-integration": "vendor/bin/phpunit --testsuite=\"Integration Tests\"",
    "test-coverage": "vendor/bin/phpunit --coverage-html tests/coverage/html"
  },
  "config": {
    "platform": {
      "php": "7.4"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "require": {
    "php": "^7.4",
    "php-stubs/wordpress-stubs": "^6.0",
    "symfony/http-kernel": "^5.4",
    "symfony/dependency-injection": "^5.4",
    "symfony/translation-contracts": "^2.5",
    "firebase/php-jwt": "^6.3"
  }
}
