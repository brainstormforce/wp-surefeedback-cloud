# SureFeedback Environment Configuration
# Copy this file to .env and configure for your environment

# Environment (development, staging, production)
SUREFEEDBACK_ENV=development

# Application URLs
SUREFEEDBACK_APP_URL=http://localhost:3000
SUREFEEDBACK_API_URL=http://localhost:8000/api/v1

# For Staging Environment:
# SUREFEEDBACK_ENV=staging
# SUREFEEDBACK_APP_URL=https://app-staging.surefeedback.com
# SUREFEEDBACK_API_URL=https://api-staging.surefeedback.com/api/v1

# For Production Environment:
# SUREFEEDBACK_ENV=production
# SUREFEEDBACK_APP_URL=https://app.surefeedback.com
# SUREFEEDBACK_API_URL=https://api.surefeedback.com/api/v1