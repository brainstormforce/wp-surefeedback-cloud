# SureFeedback Environment Configuration
# Copy this file to .env and configure for your environment

# Active Environment (development, staging, production)
# This determines which environment configuration to use
ACTIVE_ENV=development

# Development Environment
SUREFEEDBACK_ENV_DEVELOPMENT=development
SUREFEEDBACK_APP_URL_DEVELOPMENT=http://localhost:3000
SUREFEEDBACK_API_URL_DEVELOPMENT=http://localhost:8000/api/v1

# Staging Environment
SUREFEEDBACK_ENV_STAGING=staging
SUREFEEDBACK_APP_URL_STAGING=https://app-staging.surefeedback.com
SUREFEEDBACK_API_URL_STAGING=https://api-staging.surefeedback.com/api/v1

# Production Environment
SUREFEEDBACK_ENV_PRODUCTION=production
SUREFEEDBACK_APP_URL_PRODUCTION=https://app.surefeedback.com
SUREFEEDBACK_API_URL_PRODUCTION=https://api.surefeedback.com/api/v1