parameters:
	ignoreErrors:
		# False positives - openssl_random_pseudo_bytes can return false but PHPStan doesn't understand the context
		-
			message: "#^Comparison operation \">=\" between int<2, max> and 2 is always true\\.$#"
			count: 1
			path: includes/class-secure-cookie-manager.php
		-
			message: "#^Unreachable statement - code above always terminates\\.$#"
			count: 1
			path: includes/class-secure-cookie-manager.php
		-
			message: "#^Strict comparison using === between false and string will always evaluate to false\\.$#"
			count: 3
			path: includes/class-secure-cookie-manager.php
		-
			message: "#^Result of \\|\\| is always false\\.$#"
			count: 1
			path: includes/class-secure-cookie-manager.php
