{
	"name": "surefeedback",
	"version": "0.0.3",
	"description": "SureFeedback WordPress Plugin",
	"main": "index.js",
	"type": "module",
	"scripts": {
		"build": "npm run build:css && npm run build:js",
		"build:js": "webpack --mode production",
		"build:css": "tailwindcss -i ./assets/tailwind.input.css -o ./assets/dist/admin.css --minify",
		"watch": "concurrently \"npm run watch:js\" \"npm run watch:css\"",
		"watch:js": "webpack --watch --mode development",
		"watch:css": "tailwindcss -i ./assets/tailwind.input.css -o ./assets/dist/admin.css --watch",
		"dev": "concurrently \"npm run watch:js\" \"npm run watch:css\"",
		"i18n": "grunt --gruntfile Gruntfile.cjs i18n",
		"readme": "grunt --gruntfile Gruntfile.cjs readme",
		"zip": "grunt --gruntfile Gruntfile.cjs release",
		"release": "npm run build && grunt --gruntfile Gruntfile.cjs release",
		"grunt": "grunt --gruntfile Gruntfile.cjs",
		"grunt:build": "grunt --gruntfile Gruntfile.cjs build"
	},
	"keywords": [
		"wordpress",
		"plugin",
		"feedback"
	],
	"author": "Brainstorm Force",
	"license": "GPL-2.0-or-later",
	"dependencies": {
		"@radix-ui/react-alert-dialog": "^1.1.15",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@radix-ui/react-label": "^2.1.7",
		"@radix-ui/react-navigation-menu": "^1.2.14",
		"@radix-ui/react-separator": "^1.1.7",
		"@radix-ui/react-slot": "^1.2.3",
		"@radix-ui/react-switch": "^1.2.6",
		"@wordpress/i18n": "^6.9.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^0.552.0",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"react-router-dom": "^6.14.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.3.1"
	},
	"devDependencies": {
		"@babel/core": "^7.22.5",
		"@babel/preset-env": "^7.22.5",
		"@babel/preset-react": "^7.22.5",
		"@tailwindcss/cli": "^4.1.17",
		"@tailwindcss/postcss": "^4.1.17",
		"autoprefixer": "^10.4.21",
		"babel-loader": "^9.1.2",
		"concurrently": "^8.2.0",
		"css-loader": "^6.8.1",
		"grunt": "^1.6.1",
		"grunt-contrib-clean": "^2.0.1",
		"grunt-contrib-compress": "^2.0.0",
		"grunt-contrib-copy": "^1.0.0",
		"grunt-shell": "^3.0.1",
		"grunt-wp-i18n": "^1.0.3",
		"grunt-wp-readme-to-markdown": "^2.0.1",
		"mini-css-extract-plugin": "^2.7.6",
		"postcss": "^8.5.6",
		"postcss-loader": "^7.3.3",
		"style-loader": "^3.3.3",
		"tailwindcss": "^4.1.17",
		"terser-webpack-plugin": "^5.4.0",
		"webpack": "^5.88.0",
		"webpack-cli": "^5.1.4"
	}
}
